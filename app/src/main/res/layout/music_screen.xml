<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <com.google.android.material.tabs.TabLayout
        android:id="@+id/musicTabs"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <com.google.android.material.tabs.TabItem
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/tab_original" />

        <com.google.android.material.tabs.TabItem
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/tab_mixer" />
    </com.google.android.material.tabs.TabLayout>

    <!-- Original music player interface. -->
    <LinearLayout
        android:id="@+id/originalContent"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:padding="20dp">

        <!-- Choose an imported song from the library. -->
        <Spinner
            android:id="@+id/songPicker"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <!-- Placeholder for album artwork. -->
        <ImageView
            android:id="@+id/albumArtwork"
            android:layout_width="160dp"
            android:layout_height="160dp"
            android:layout_marginTop="24dp"
            android:src="@android:drawable/ic_menu_gallery"
            android:contentDescription="@null" />

        <!-- Current song information. -->
        <TextView
            android:id="@+id/songTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:gravity="center"
            android:text="@string/player_no_song"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/songArtist"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="@string/player_unknown_artist"
            android:textSize="16sp" />

        <!-- Playback progress and elapsed time. -->
        <SeekBar
            android:id="@+id/songProgress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:enabled="false" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/currentTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0:00" />

            <Space
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/totalTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0:00" />
        </LinearLayout>

        <!-- Basic playback controls. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:gravity="center"
            android:orientation="horizontal">

            <Button
                android:id="@+id/previousSongButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/player_previous"
                android:enabled="false" />

            <Button
                android:id="@+id/playPauseButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="12dp"
                android:text="@string/player_play"
                android:enabled="false" />

            <Button
                android:id="@+id/nextSongButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/player_next"
                android:enabled="false" />

        </LinearLayout>

    </LinearLayout>

    <!-- Mixer tab: StemMixerScreen is placed here, hidden until Mixer is selected -->
    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/mixerContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:visibility="gone" />

</LinearLayout>