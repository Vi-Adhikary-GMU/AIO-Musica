<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent">
<TextView android:id="@+id/playlistTitle" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_margin="16dp" android:ellipsize="end" android:maxLines="1" android:textAppearance="?attr/textAppearanceHeadlineSmall" app:layout_constraintEnd_toStartOf="@id/addSongsButton" app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toTopOf="parent"/>
